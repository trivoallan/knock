__pycache__/
*.pyc
.venv/
.uv-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
*.egg-info/
.env
.env.*
!.env.example
.serena/
.DS_Store

# Implementation plans are a local working artifact — never committed, never on main.
# (Specs DO persist, under docs/superpowers/specs/.)
docs/superpowers/plans/

# Structurizr generated artifacts — docs/architecture/workspace.dsl is the source of truth.
# The Mermaid exports (_export/*.mmd) ARE committed so the views render on GitHub without a
# Structurizr instance; refresh them whenever workspace.dsl changes (see the maintenance contract).
docs/architecture/.structurizr/
docs/architecture/workspace.json
docs/architecture/_export/*
!docs/architecture/_export/*.mmd
docs/architecture/build/

# Docusaurus (website/ has its own .gitignore too)
website/node_modules/
website/build/
website/.docusaurus/

# gstack session artefacts (local tooling, never project content)
.gstack/

# nanopm PM wiki — the schema (NANOPM-WIKI.md) and the generated catalog (wiki/index.md)
# ARE committed: they are the compounding artifact, and agents read them fresh each run.
# Two exceptions:
#   .lock   an advisory flock taken by every writer — pure runtime state.
#   raw/    verbatim archives of feedback, interviews and data exports. THIS REPO IS
#           PUBLIC (see CLAUDE.md): committing raw sources would publish customer
#           material. Drop this line if a deployment ever wants them tracked.
.nanopm/wiki/.lock
.nanopm/raw/
